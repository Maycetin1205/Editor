    <ff-text data-ff-main fills style="grid-column:1 / span 12;grid-row:17 / span 2;min-width:0;min-height:0"></ff-text>
    <ff-status data-ff-main fills style="grid-column:1 / span 12;grid-row:19 / span 2;min-width:0;min-height:0"></ff-status>
    <ff-image data-ff-main fills style="grid-column:1 / span 12;grid-row:21 / span 2;min-width:0;min-height:0"></ff-image>
    <ff-valuelist data-ff-main fills style="grid-column:1 / span 12;grid-row:23 / span 2;min-width:0;min-height:0"></ff-valuelist>
