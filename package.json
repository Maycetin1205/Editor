{
  "name": "aufbau-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run build:runtime",
    "build": "tsc -b && vite build",
    "prebuild": "npm run build:runtime",
    "build:runtime": "vite build --config vite.runtime.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "pretest": "npm run build:runtime",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run build:runtime && tsc -b && eslint . && prettier --check . && vitest run"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.6",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "happy-dom": "^21.0.4",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.12"
  }
}
