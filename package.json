{
  "name": "aufbau-editor",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:runtime": "node tools/buildRuntime.mjs",
    "test": "vitest run",
    "pretest": "npm run build:runtime",
    "check": "tsc -b && eslint . && prettier --check . && npm run cycles && npm run knip && vitest run",
    "predev": "npm run build:runtime",
    "prebuild": "npm run build:runtime",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --no-progress",
    "cycles": "node tools/cycles.mjs --max 8"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lit": "^3.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.6",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "happy-dom": "^21.0.4",
    "knip": "5.88.1",
    "postcss": "^8.5.27",
    "prettier": "3.9.10",
    "rolldown": "~1.2.7",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.12"
  }
}
